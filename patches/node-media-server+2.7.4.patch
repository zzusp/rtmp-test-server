+const { spawn, execSync } = require('child_process');
 const context = require('./node_core_ctx');
 
 function generateNewSessionID() {
@@ -46,8 +46,43 @@ function verifyAuth(signStr, streamId, secretKey) {
   return shv === ohv;
 }
 
+async function getFFmpegVersion(ffmpegPath) {
+  return new Promise((resolve) => {
+    try {
+      const result = execSync(`"${ffmpegPath}" -version`, { encoding: 'utf8', maxBuffer: 1024 * 1024 });
+      const match = result.match(/ffmpeg version ([^\s]+)/);
+      if (match && match[1]) {
+        resolve(match[1]);
+      } else {
+        resolve('');
+      }
+    } catch (error) {
+      resolve('');
+    }
+  });
+}
+
+function getFFmpegUrl() {
+  const platform = process.platform;
+  const arch = process.arch;
+  
+  if (platform === 'win32') {
+    if (arch === 'x64') {
+      return 'https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip';
+    }
+  } else if (platform === 'darwin') {
+    return 'https://evermeet.cx/ffmpeg/';
+  } else if (platform === 'linux') {
+    return 'https://johnvansickle.com/ffmpeg/';
+  }
+  
+  return 'https://ffmpeg.org/download.html';
+}
+
 module.exports = {
   generateNewSessionID,
   verifyAuth,
   genRandomName,
+  getFFmpegVersion,
+  getFFmpegUrl,
 };
